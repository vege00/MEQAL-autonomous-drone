[Unit]
Description=PTP Master Clock for Livox MID-360
After=drone-eno1-online.service
Requires=drone-eno1-online.service

[Service]
Environment=CYCLONEDDS_URI=file:///etc/cyclonedds/drone.xml
Type=simple
ExecStart=/usr/sbin/ptp4l -i eno1 -m -S --masterOnly 1
Restart=on-failure
RestartSec=3s

[Install]
WantedBy=multi-user.target
