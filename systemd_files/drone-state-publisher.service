[Unit]
Description=ROS2 Robot State Publisher
After=drone-eno1-online.service
Requires=drone-eno1-online.service

[Service]
Environment=CYCLONEDDS_URI=file:///etc/cyclonedds/drone.xml
Type=simple
User=drone008
Environment=HOME=/home/drone008
ExecStartPre=/bin/sleep 10
ExecStart=/home/drone008/ws_auto_drone_008/scripts/start_state_publisher.sh
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
