[Unit]
Description=ROS2 joining MAVROS map tf to cacmera_init tf
After=drone-state-publisher.service


[Service]
Environment=CYCLONEDDS_URI=file:///etc/cyclonedds/drone.xml
Type=simple
User=drone008
ExecStartPre=/bin/sleep 5
ExecStart=/bin/bash -c "\
  export RMW_IMPLEMENTATION=rmw_cyclonedds_cpp && \
  source /opt/ros/humble/setup.bash && \
  source /home/drone008/ws_auto_drone_008/install/setup.bash && \
  source /home/drone008/ws_livox_drivers/install/setup.bash && \
  ros2 run tf2_ros static_transform_publisher 0 0 0 0 0 0 camera_init map"
Restart=on-failure

[Install]
WantedBy=multi-user.target

